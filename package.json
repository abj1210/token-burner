{
  "name": "@local/token-burner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "按指定金额（人民币元）快速消耗 token 的 DSH 插件：真实调用模型、真实扣费，带预算锁、余额对账与审计日志。默认硬上限 1 元。",
  "license": "MIT",
  "main": "index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "token",
    "burn"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "lib",
    "tools"
  ]
}
